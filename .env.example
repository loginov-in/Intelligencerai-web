# Скопируйте в .env и заполните значениями
# cp .env.example .env

# --- База данных ---
POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
POSTGRESQL_DBNAME=

# --- Секретный ключ Flask (генерация: python3 -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=

# --- Администратор по умолчанию ---
ADMIN_PASSWORD=

# --- SMTP ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# --- S3 Service Key ---
S3_URL=
S3_Access_Key=
S3_Secret_Access_Key=
baget_name=
reguon=
